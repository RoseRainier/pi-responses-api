{
  "name": "pi-responses-api",
  "version": "0.1.1",
  "description": "Pi extension that exposes the Pi coding agent through an OpenAI Responses API compatible HTTP server",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoseRainier/pi-responses-api.git"
  },
  "homepage": "https://github.com/RoseRainier/pi-responses-api#readme",
  "bugs": {
    "url": "https://github.com/RoseRainier/pi-responses-api/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "openai",
    "responses-api",
    "llm",
    "agent"
  ],
  "files": [
    "src",
    "extensions",
    "bin",
    "examples",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "pi-responses-server": "bin/pi-responses-server.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/responses-api.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "test:e2e": "node test/e2e.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "^26.6.3",
    "openai": "^7.23.0",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.6"
  }
}
